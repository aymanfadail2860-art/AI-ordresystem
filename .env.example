# AI Dispatch – eksempel på miljøvariabler
#
# VIGTIGT: API-nøgler til drift (Claude, Telegram, Google Maps) indtastes i
# programmet (Indstillinger → Integrationer) og gemmes krypteret via macOS
# Keychain. De skal IKKE ligge i .env-filer. Commit aldrig rigtige nøgler.

# Kun til udvikling: datamappe for dev-webserveren (npm run dev:web)
AI_DISPATCH_DATA=./data/dev
PORT=5199

# Kun til bygning/signering/notarisering af .dmg (på build-Mac'en / CI)
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
CSC_LINK=
CSC_KEY_PASSWORD=
# Token til at udgive releases (opdateringskanal)
GH_TOKEN=
